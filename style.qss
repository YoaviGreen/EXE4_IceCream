QWidget {
    background-color: #f1f5f9;
    color: #1e293b;
    font-size: 14px;
}

QPushButton {
    background-color: #2563eb;
    color: white;
    border-radius: 6px;
    padding: 6px 12px;
}

QPushButton:hover {
    background-color: #3b82f6;
}

QPushButton:pressed {
    background-color: #1e3a8a;
}

QLineEdit {
    background-color: white;
    border: 1px solid #94a3b8;
    border-radius: 6px;
    padding: 4px;
}

QLineEdit#output {
    background-color: #e2e8f0;
    color: #475569;
}

#about_window,
#about_name,
#about_email,
#about_link {
    background-color: #2b2b2b;
    color: white;
}

#about_name {
    font-size: 26px;
    font-weight: bold;
    color: #3498db;
    border-bottom: 2px solid #555555;
}

#about_email {
    font-size: 16px;
    color: #bdc3c7;
}

#about_link {
    font-size: 16px;
}

#about_picture {
    border: 3px solid #3498db;
    border-radius: 10px;
    padding: 5px;
    background-color: #1e1e1e;
}